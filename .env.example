# Kafka/Redpanda
KAFKA_BROKERS=localhost:19092

# Wikimedia producer
WIKIMEDIA_STREAM_URL=https://stream.wikimedia.org/v2/stream/recentchange
PRODUCER_MAX_SECONDS=30
PRODUCER_LOG_EVERY=100

# SQLite projection
SQLITE_PATH=.data/wiki-stream-lab.sqlite

# Demo/backpressure
SLOW_CONSUMER_MS=0

# Archiver -> S3-compatible object store (RustFS). Raw verbatim JSONL backup of
# the validated topic. Defaults match the local RustFS in docker-compose.
# Host runs use localhost:9100; in-compose the archiver uses http://rustfs:9000.
S3_ENDPOINT=http://localhost:9100
S3_REGION=us-east-1
S3_ACCESS_KEY=rustfsadmin
S3_SECRET_KEY=rustfsadmin
S3_BUCKET=wiki-stream-lab
ARCHIVE_MAX_ROWS=5000
ARCHIVE_FLUSH_SECONDS=10

# Laker -> Parquet "lake" in the same RustFS bucket (lake/ prefix). Parquet
# wants large row groups, so batches are big: bigger objects, better scans.
LAKE_MAX_ROWS=50000
LAKE_FLUSH_SECONDS=60
