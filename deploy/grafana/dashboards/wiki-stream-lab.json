{
  "annotations": { "list": [] },
  "editable": true,
  "graphTooltip": 0,
  "schemaVersion": 39,
  "title": "wiki-stream-lab (ClickHouse)",
  "tags": ["wiki-stream-lab"],
  "time": { "from": "now-30m", "to": "now" },
  "refresh": "5s",
  "templating": { "list": [] },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Total events",
      "datasource": { "type": "grafana-clickhouse-datasource", "uid": "clickhouse" },
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 0 },
      "options": { "colorMode": "value", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [
        { "refId": "A", "datasource": { "type": "grafana-clickhouse-datasource", "uid": "clickhouse" }, "editorType": "sql", "queryType": "table", "rawSql": "SELECT count() AS total FROM wsl.events" }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Throughput (events / min)",
      "datasource": { "type": "grafana-clickhouse-datasource", "uid": "clickhouse" },
      "gridPos": { "h": 6, "w": 18, "x": 6, "y": 0 },
      "fieldConfig": { "defaults": { "custom": { "drawStyle": "bars", "fillOpacity": 40 } }, "overrides": [] },
      "targets": [
        { "refId": "A", "datasource": { "type": "grafana-clickhouse-datasource", "uid": "clickhouse" }, "editorType": "sql", "queryType": "timeseries", "rawSql": "SELECT toStartOfMinute(occurred_at) AS time, count() AS events FROM wsl.events GROUP BY time ORDER BY time" }
      ]
    },
    {
      "id": 3,
      "type": "piechart",
      "title": "Events by type",
      "datasource": { "type": "grafana-clickhouse-datasource", "uid": "clickhouse" },
      "gridPos": { "h": 9, "w": 8, "x": 0, "y": 6 },
      "options": { "pieType": "pie", "legend": { "displayMode": "table", "placement": "right", "values": ["value", "percent"] }, "reduceOptions": { "values": true, "calcs": [] } },
      "targets": [
        { "refId": "A", "datasource": { "type": "grafana-clickhouse-datasource", "uid": "clickhouse" }, "editorType": "sql", "queryType": "table", "rawSql": "SELECT event_type, count() AS c FROM wsl.events GROUP BY event_type ORDER BY c DESC" }
      ]
    },
    {
      "id": 4,
      "type": "barchart",
      "title": "Top 5 wikis",
      "datasource": { "type": "grafana-clickhouse-datasource", "uid": "clickhouse" },
      "gridPos": { "h": 9, "w": 8, "x": 8, "y": 6 },
      "options": { "orientation": "horizontal", "legend": { "showLegend": false } },
      "targets": [
        { "refId": "A", "datasource": { "type": "grafana-clickhouse-datasource", "uid": "clickhouse" }, "editorType": "sql", "queryType": "table", "rawSql": "SELECT wiki, count() AS c FROM wsl.events GROUP BY wiki ORDER BY c DESC LIMIT 5" }
      ]
    },
    {
      "id": 5,
      "type": "table",
      "title": "Last 10 events",
      "datasource": { "type": "grafana-clickhouse-datasource", "uid": "clickhouse" },
      "gridPos": { "h": 9, "w": 8, "x": 16, "y": 6 },
      "targets": [
        { "refId": "A", "datasource": { "type": "grafana-clickhouse-datasource", "uid": "clickhouse" }, "editorType": "sql", "queryType": "table", "rawSql": "SELECT occurred_at, wiki, event_type, user, title FROM wsl.events ORDER BY ingested_at DESC LIMIT 10" }
      ]
    }
  ]
}
